{
    "name": "detain/sshwitch",
    "description": "Login and run commands on your network devices via an ssh connection on a remote server. Easy to use PHP static class methods with static chaining support for rapid development. Supports Cisco and Juniper network routers and switches with more easily added.",
    "type": "library",
    "license": "GPL-3.0",
    "keywords": [
        "ssh",
        "ssh-client",
        "network-automation",
        "network-device",
        "network-device-management",
        "router",
        "switch",
        "juniper",
        "cisco",
        "automation",
        "remote-access",
        "cli",
        "command-line",
        "chainable",
        "static-chain",
        "tty",
        "php",
        "php-library"
    ],
    "authors": [
        {
            "name": "Joe Huss",
            "email": "detain@interserver.net"
        }
    ],
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-text"
    },
    "require": {
        "php": "^7.4 || ^8.0",
        "ext-ssh2": "*"
    },
    "require-dev": {
        "php-mock/php-mock": "^2.5",
        "php-mock/php-mock-phpunit": "^2.6",
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "Detain\\Sshwitch\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Detain\\Sshwitch\\Tests\\": "tests/"
        }
    }    
}
